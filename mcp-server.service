# pocket-mcp 的 systemd 单元模板
#
# 不用 install.sh、想手动装时用这份。把下面四个占位符换掉，然后：
#   sudo cp mcp-server.service /etc/systemd/system/pocket-mcp.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now pocket-mcp
#
# 占位符：
#   @USER@      运行服务的专用低权限用户（不要用 root），例如 pocketmcp
#               创建：sudo useradd --system --home-dir /opt/pocket-mcp --no-create-home \
#                       --shell /usr/sbin/nologin pocketmcp
#   @PYTHON@    python3 的绝对路径，例如 /usr/bin/python3
#   @WORKDIR@   代码目录，例如 /opt/pocket-mcp
#   @WORKSPACE@ 工作区目录（文件工具只能在这里读写），例如 /srv/pocket-mcp-workspace
#               创建：sudo install -d -m 0750 -o pocketmcp -g pocketmcp /srv/pocket-mcp-workspace

[Unit]
Description=pocket-mcp (MCP server for mobile clients)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@WORKDIR@
Environment=MCP_WORKSPACE=@WORKSPACE@
# 允许 run_command 才设为 1（等于给这个低权限用户一个远程 shell，谨慎）
Environment=MCP_ALLOW_SHELL=0
ExecStart=@PYTHON@ -u @WORKDIR@/server.py --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=2

# --- 安全加固：即使服务被利用，也难以影响系统 ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ReadWritePaths=@WORKSPACE@
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
